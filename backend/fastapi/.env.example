# =============================================================================
# ECOBRIDGES FastAPI voice service TEMPLATE - copy to `.env` (git-ignored)
# =============================================================================

# Comma-separated list of allowed browser origins. Empty = no browser origin is
# allowed (native apps are unaffected by CORS).
CORS_ORIGINS=

# Maximum accepted audio upload size in bytes (default 10 MiB).
MAX_AUDIO_BYTES=10485760

# Maximum transcript length accepted by the intent endpoint (characters).
MAX_TRANSCRIPT_CHARS=2000

# Optional shared secret. When set, every business endpoint requires a matching
# X-API-Key header. Leave empty when the service is only reachable from the
# authenticated NestJS gateway on a private network.
VOICE_API_KEY=

# faster-whisper settings.
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# Set to 1 to start without a model (health checks only; transcription returns 503).
WHISPER_DISABLE_MODEL=
