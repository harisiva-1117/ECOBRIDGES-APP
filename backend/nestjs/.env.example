```env
# =============================================================================
# ECOBRIDGES NestJS Backend Environment Template
# Copy to .env for local development. Never commit real credentials.
# =============================================================================

PORT=3000

# Supabase project
SUPABASE_URL=https://ekqatebpbvxwjohfhipf.supabase.co

# Publishable key (safe for client-side use with appropriate security policies)
SUPABASE_ANON_KEY=your_supabase_publishable_or_anon_key_here

# Supabase secret key (server-side only)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_secret_key_here

# JWT verification
SUPABASE_JWKS_URL=https://ekqatebpbvxwjohfhipf.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=authenticated

# Only required for legacy HS256 JWT verification.
# Do not put an sb_secret_ key here.
SUPABASE_JWT_SECRET=

# Demo login (disabled by default)
DEMO_LOGIN_ENABLED=false
DEMO_JWT_SECRET=
DEMO_OTP_CODE=123456
DEMO_ENABLE_ADMIN=false
DEMO_ACCOUNTS=9876543210:collector,9876543211:recycler,9876543212:admin

# CORS
CORS_ORIGINS=

# FastAPI voice/AI service
FASTAPI_VOICE_URL=http://127.0.0.1:8000
```
