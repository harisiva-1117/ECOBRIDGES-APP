# =============================================================================
# ECOBRIDGES Android - build-time configuration TEMPLATE
# =============================================================================
# Copy this file to `.env` and fill in real values. `.env` is git-ignored.
# Values are injected into BuildConfig by the Secrets Gradle Plugin.
#
# NEVER put a service_role / sb_secret_ key here. This file is packaged into
# the APK; only the Supabase publishable (anon) key is safe on the client.
#
# NOTE: keep this file to `KEY=VALUE` lines plus simple `#` comments. The
# Secrets plugin mis-parses `# KEY: text` comment lines.
# =============================================================================

# Supabase project URL, for example https://<project-ref>.supabase.co
SUPABASE_URL=https://ekqatebpbvxwjohfhipf.supabase.co
# Supabase publishable / anon key (client-safe, protected by RLS).
SUPABASE_ANON_KEY=

# Google OAuth 2.0 Web client ID used by Credential Manager.
GOOGLE_WEB_CLIENT_ID=

# Google Maps SDK key, restricted to the app package and SHA-1 in Cloud Console.
MAPS_API_KEY=

# Gemini API key (optional, the on-device ONNX scanner works without it).
GEMINI_API_KEY=

# OTP_MODE accepts demo or sms.
# demo - on-device Demo OTP, clearly labelled, never sent by SMS, debug builds only.
# sms  - reserved for a real SMS provider integration (not implemented yet).
OTP_MODE=demo

# -----------------------------------------------------------------------------
# DEMO LOGIN (hackathon only - NOT production authentication)
# -----------------------------------------------------------------------------
# No SMS is sent. The code below is compiled into the app and shown on screen,
# so it proves nothing about the identity of the person entering it.
#
# DEMO_LOGIN_ENABLED is ON by default in debug builds and OFF by default in
# release builds. A release build additionally requires
# DEMO_LOGIN_ALLOW_RELEASE=true (do not ship that to end users).
DEMO_LOGIN_ENABLED=true
DEMO_LOGIN_ALLOW_RELEASE=false
# Six-digit demo code. Default example: 123456. Change it for your demo.
DEMO_OTP_CODE=123456
# Allow the Admin demo portal. Admin demo accounts are only honoured when the
# phone number is listed in DEMO_ACCOUNTS with the admin role.
DEMO_ENABLE_ADMIN=true
# Comma-separated phone:role demo accounts. Roles: collector, recycler, admin.
# A phone listed here can only open the role configured for it.
DEMO_ACCOUNTS=9876543210:collector,9876543211:recycler,9876543212:admin
